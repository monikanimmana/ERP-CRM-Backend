# Django
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM Provider — choose one: gemini | claude | openai | rules_fallback
LLM_PROVIDER=rules_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (optional — if not set, email actions return real: false with preview)
# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=saydone@example.com
SUMMARY_EMAIL_TO=you@example.com

# CORS extra origins (comma-separated, added to defaults)
EXTRA_CORS_ORIGINS=
