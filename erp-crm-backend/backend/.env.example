# Database — PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erp_crm_db?schema=public"

# JWT secret — use a long random string in production (min 32 chars)
JWT_SECRET="change_me_to_a_long_random_secret_string"

# JWT expiry — default 7 days
JWT_EXPIRES_IN="7d"

# Server port
PORT=4000

# Node environment
NODE_ENV="development"
